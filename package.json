{
  "name": "ai-agent-orchestrator",
  "displayName": "AI Agent Orchestrator",
  "description": "Orchestrate multiple AI agents for development tasks in VS Code",
  "version": "0.1.0",
  "publisher": "ai-agent-orchestrator",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "AI",
    "agent",
    "orchestrator",
    "LLM",
    "workflow"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-agent-orchestrator/vscode-extension"
  },
  "icon": "media/icon.png",
  "activationEvents": [
    "onCommand:aiAgentOrchestrator.openPanel",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiAgentOrchestrator.openPanel",
        "title": "%commands.openPanel%",
        "category": "AI Agent"
      },
      {
        "command": "aiAgentOrchestrator.createFromTemplate",
        "title": "%commands.createFromTemplate%",
        "category": "AI Agent"
      },
      {
        "command": "aiAgentOrchestrator.configureApiKeys",
        "title": "%commands.configureApiKeys%",
        "category": "AI Agent"
      },
      {
        "command": "aiAgentOrchestrator.runPrompt",
        "title": "Run Prompt (for external agents)",
        "category": "AI Agent"
      },
      {
        "command": "aiAgentOrchestrator.getLastOutput",
        "title": "Get Last Output (for external agents)",
        "category": "AI Agent"
      },
      {
        "command": "aiAgentOrchestrator.resetState",
        "title": "Reset Extension State",
        "category": "AI Agent"
      }
    ],
    "keybindings": [
      {
        "command": "aiAgentOrchestrator.openPanel",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "!aiAgentOrchestratorFocused"
      }
    ],
    "configuration": {
      "title": "AI Agent Orchestrator",
      "properties": {
        "aiAgentOrchestrator.defaultModel": {
          "type": "string",
          "default": "gpt-4o",
          "description": "%config.defaultModel%"
        },
        "aiAgentOrchestrator.ollamaEndpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server endpoint URL for local LLM execution (e.g. http://localhost:11434)"
        },
        "aiAgentOrchestrator.contextMode": {
          "type": "string",
          "enum": [
            "file",
            "project"
          ],
          "enumDescriptions": [
            "Active file only — same as the original single-file behavior",
            "Entire project — file tree + active file + related files (recommended)"
          ],
          "default": "project",
          "description": "Context mode passed to agents. 'project' gives agents full project understanding; 'file' limits to the active editor file."
        },
        "aiAgentOrchestrator.contextTokenBudget": {
          "type": "number",
          "default": 32000,
          "minimum": 4000,
          "maximum": 200000,
          "description": "Maximum tokens to spend on project context (related files). Increase for larger models; decrease to reduce costs."
        },
        "aiAgentOrchestrator.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "ja"
          ],
          "enumDescriptions": [
            "Auto (VS Code Display Language)",
            "English",
            "Japanese (日本語)"
          ],
          "description": "Global language for UI and generated workflows/plans"
        },
        "aiAgentOrchestrator.planSkipPreview": {
          "type": "boolean",
          "default": false,
          "description": "Skip the plan preview dialog and copy directly to clipboard"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js",
    "dev": "node esbuild.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:extension": "node ./dist/test/runTest.js",
    "lint": "eslint src --ext ts,tsx",
    "format": "prettier --write 'src/**/*.{ts,tsx,json}'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@google/generative-ai": "^0.15.0",
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "i18next": "^23.14.0",
    "openai": "^4.57.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^15.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.35",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.21.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}